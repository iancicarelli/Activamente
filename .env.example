# Copiar a `.env` en la raíz del repo. docker-compose.yml lo inyecta a db y backend.
POSTGRES_USER=activamente
POSTGRES_PASSWORD=activamente
POSTGRES_DB=activamente_db

# Vista desde el contenedor backend (host = nombre del servicio `db`).
DATABASE_URL=postgresql://activamente:activamente@db:5432/activamente_db

# Obligatorio: app/core/security.py falla al arrancar si falta.
# Generar uno: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=cambiame-por-un-secreto-largo-y-aleatorio
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Puertos en el host (no predeterminados para no chocar con otras apps):
#   API FastAPI  → 8420  (docker-compose.yml / Dockerfile)
#   Postgres     → 55432 (docker-compose.override.yml; dentro de la red docker sigue en 5432)
#   Metro/Expo   → 8421  (activamente-front/package.json)

# ── Despliegue (VPS). Ver activamente-back/CLAUDE.md "Despliegue" ─────────────
# Nombre del ambiente: separa contenedores, red y volumen de prod y dev en la misma VPS.
# En local se puede omitir (queda "activamente", el nombre de la carpeta).
# COMPOSE_PROJECT_NAME=activamente-prod        # o activamente-dev

# Alias del backend en la red `proxy` de Caddy. ÚNICO por ambiente en toda la VPS.
# Obligatorio para docker compose (en local da igual el valor: el override no usa la red proxy).
PROXY_ALIAS=activamente-api                    # activamente-api-dev en dev

# IP/red desde la que uvicorn acepta X-Forwarded-For (la de Caddy: red `proxy`, 172.30.0.0/24).
# Sin esto, detrás de Caddy todas las peticiones tendrían la IP del proxy y el límite de login
# (SEC-05) bloquearía a todos a la vez. En local no se define (default 127.0.0.1).
# FORWARDED_ALLOW_IPS=172.30.0.0/24

# Límite de intentos fallidos de login (SEC-05). Defaults:
# LOGIN_MAX_FAILURES=5
# LOGIN_MAX_FAILURES_PER_IP=50
# LOGIN_WINDOW_SECONDS=900
