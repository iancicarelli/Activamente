# Copiar a `.env` en la raíz del repo. docker-compose.yml lo inyecta a db y backend.
POSTGRES_USER=activamente
POSTGRES_PASSWORD=change_me
POSTGRES_DB=activamente_db

# Vista desde el contenedor backend (host = nombre del servicio `db`).
DATABASE_URL=postgresql://activamente:change_me@db:5432/activamente_db

# Obligatorio: app/core/security.py falla al arrancar si falta.
# Generar uno: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=cambiame-por-un-secreto-largo-y-aleatorio
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Puertos en el host (no predeterminados para no chocar con otras apps):
#   API FastAPI  → 8420  (docker-compose.yml / Dockerfile)
#   Postgres     → 55432 (docker-compose.override.yml; dentro de la red docker sigue en 5432)
#   Metro/Expo   → 8421  (activamente-front/package.json)
