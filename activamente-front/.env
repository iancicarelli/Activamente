# URL del backend FastAPI visto desde el celular.
# 192.168.1.89 es la IP de tu PC en la WiFi (celular y PC en la misma red).
# Si tu IP cambia, actualizá esta línea y reiniciá Metro.
#RED CASA
EXPO_PUBLIC_API_URL=http://192.168.1.88:8000
#RED UFRO
#EXPO_PUBLIC_API_URL=http://172.40.93.67:8000
#npx expo start -c       # el -c limpia caché para que tome el .env nuevo
# en otra terminal o desde el menú:
#npx expo run:android    # compila e instala el dev build en el celu
