{
  "expo": {
    "name": "ActivaMente",
    "slug": "activamente-front",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logoActivaMente.png",
    "scheme": "activamentefront",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.activamente.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/logoActivaMente.png",
        "backgroundImage": "./assets/images/logoActivaMente.png",
        "monochromeImage": "./assets/images/logoActivaMente.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.activamente.app",
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/logoActivaMente.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/logoActivaMente.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-web-browser",
      [
        "react-native-vision-camera",
        {
          "cameraPermissionText": "ActivaMente necesita la cámara para evaluar los ejercicios en tiempo real.",
          "enableMicrophonePermission": false
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "72015a62-13b3-4066-b9e2-f5523ed4bda9"
      }
    }
  }
}
